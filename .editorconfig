# EditorConfig配置文件
# 用于统一代码风格和抑制某些警告

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
indent_style = space
indent_size = 4
max_line_length = 120

# Kotlin代码风格
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# 抑制KTX扩展函数建议
# 我们选择使用传统的edit().apply()而不是edit { }
# 原因：更清晰、团队更熟悉、性能差异可忽略
