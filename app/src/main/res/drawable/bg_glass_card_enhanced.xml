<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 外层阴影 - 模拟透光效果 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="#0DFFFFFF"/>
        </shape>
    </item>
    
    <!-- 中层阴影 - 增强层次 -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#1AFFFFFF"/>
        </shape>
    </item>
    
    <!-- 主体毛玻璃层 -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#CCFFFFFF"/>
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF"/>
        </shape>
    </item>
    
    <!-- 内部渐变 - 增强立体感 -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:angle="135"
                android:startColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
        </shape>
    </item>
    
</layer-list>
